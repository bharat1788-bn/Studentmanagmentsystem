@{
    ViewData["Title"] = "Change Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-lg mt-5">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="font-weight-light my-2">🔑 Change Password</h4>
                </div>
                <div class="card-body p-4">

                    <!-- Yahan Success ya Error message dikhega -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger shadow-sm">
                            <strong>Error:</strong> @ViewBag.Error
                        </div>
                    }
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success shadow-sm">
                            <strong>Success:</strong> @ViewBag.Success
                        </div>
                    }

                    <form action="/Account/ChangePassword" method="post">

                        <div class="form-floating mb-3">
                            <input type="password" name="oldPassword" class="form-control" id="inputOldPassword" required placeholder="Enter current password" />
                            <label for="inputOldPassword" class="fw-bold text-muted">Old Password</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" name="newPassword" class="form-control" id="inputNewPassword" required placeholder="Enter new password" />
                            <label for="inputNewPassword" class="fw-bold text-muted">New Password</label>
                        </div>

                        <div class="form-floating mb-4">
                            <input type="password" name="confirmPassword" class="form-control" id="inputConfirmPassword" required placeholder="Confirm new password" />
                            <label for="inputConfirmPassword" class="fw-bold text-muted">Confirm New Password</label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-block py-2 fw-bold">Update Password</button>
                            <a href="/Account/Dashboard" class="btn btn-secondary btn-block py-2 fw-bold">Back to Dashboard</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>