@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <script>
        function ValidateLogin() {
            var username = document.getElementById("username").value;
            var password = document.getElementById("password").value;

            if (username == "" || password == "") {
                alert("Please Enter Username and Password");
                return false;
            }

            return true;
        }

        function ClearForm() {
            if (confirm("Do you want to clear the Login Form?")) {
                document.getElementById("username").value = "";
                document.getElementById("password").value = "";
            }
        }
    </script>
</head>

<body style="
margin:0;
background-image:url('/NewFolder/clg.jpeg');
background-size:cover;
background-position:center;
background-repeat:no-repeat;">

    <div style="
display:flex;
justify-content:center;
align-items:center;
height:100vh;">

        <div style="
width:360px;
padding:30px;
border-radius:15px;
background:white;
box-shadow:0px 0px 15px gray;
text-align:center;">

            <img src="/NewFolder/bcalogo.jpeg"
                 width="100"
                 height="100" />

            <h2>Student Management System</h2>

            <p style="color:gray;font-size:15px;margin-bottom:20px;">
                Please Login to Your Account
            </p>

            <!-- YAHAN ERROR DIKHEGA (NAYA CODE) -->
            @if (ViewBag.Error != null)
            {
                <div style="
    background-color: #ffe6e6;
    color: #cc0000;
    padding: 10px;
    border: 1px solid #cc0000;
    border-radius: 5px;
    margin-bottom: 15px;
    font-weight: bold;
    font-size: 14px;">
                    @ViewBag.Error
                </div>
            }

            <!-- FORM ACTION CHANGE KIYA HAI TAKI DIRECT C# KE POST METHOD PAR JAYE -->
            <form method="post" action="/Account/Login" onsubmit="return ValidateLogin();">

                <div style="
display:flex;
align-items:center;
margin-bottom:15px;">

                    <img src="/NewFolder/username.png"
                         width="25"
                         height="25"
                         style="margin-right:10px;" />

                    <input type="text"
                           id="username"
                           name="username"
                           placeholder="Enter Username"
                           style="
width:100%;
padding:10px;
border:1px solid gray;
border-radius:5px;" />

                </div>

                <div style="
display:flex;
align-items:center;
margin-bottom:20px;">

                    <img src="/NewFolder/password.png"
                         width="25"
                         height="25"
                         style="margin-right:10px;" />

                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="Enter Password"
                           style="
width:100%;
padding:10px;
border:1px solid gray;
border-radius:5px;" />

                </div>

                <button type="submit"
                        style="
padding:10px 20px;
background:blue;
color:white;
border:none;
border-radius:5px;">
                    Login
                </button>

                <button type="button"
                        onclick="ClearForm()"
                        style="
padding:10px 20px;
background:red;
color:white;
border:none;
border-radius:5px;
margin-left:10px;">
                    Cancel
                </button>

            </form>

            <p style="
margin-top:20px;
color:gray;
font-size:14px;">
                © 2026 BCA College. All Rights Reserved.
            </p>

        </div>

    </div>

</body>
</html>